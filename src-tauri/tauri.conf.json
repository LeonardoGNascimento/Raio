{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "raio",
  "version": "0.4.2",
  "identifier": "com.ti-09.raio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "⚡ raio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LeonardoGNascimento/Raio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2RThFNTNGQ0U3QjU0OEEKUldTS1ZIdk9QK1hvcGlGS2l3SExSSzdLbmJqcmM2YWxMU0RKWmFiNFltRkU4K0l0UlYzNlpFOHoK"
    }
  }
}
